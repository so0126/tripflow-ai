# 백엔드 API 기본 URL
# 개발: http://localhost:8080
# 프로덕션: https://api.yourdomain.com
VUE_APP_API_BASE_URL=http://localhost:8080

# Google OAuth 설정
# Google Cloud Console에서 발급받은 클라이언트 ID
VUE_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
# Google OAuth 콜백 URI
VUE_APP_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
# 백엔드 OAuth 인증 URL
VUE_APP_BACKEND_OAUTH_URL=http://localhost:8080/oauth2/authorization/google

# Naver Maps API 설정
# Naver Developers에서 발급받은 Client ID
VUE_APP_NAVER_CLIENT_ID=your_naver_client_id_here

# 개발 환경 설정
# 테스트 모드 여부 (true면 실제 API 호출 대신 Mock 데이터 사용)
VUE_APP_ENABLE_MOCK=false
